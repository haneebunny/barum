{
  "openapi": "3.1.0",
  "info": {
    "title": "barum 판정 백엔드",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "헬스체크.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/reference/basis": {
      "get": {
        "summary": "Get Reference Basis",
        "description": "지금 시점 적용 기준(프론트 푸터용). `{\"kr\": ..., \"us\": ...}`.\n\n`CheckReport.basis`와 같은 소스(citation_registry.json)에서 읽지만, 이건 항상\n\"지금\" 기준이고 검사 시점 스냅샷이 아니다. 리포트 화면은 `report.basis`를 쓰고,\n검사와 무관한 화면(홈·검사 시작 전)은 이 엔드포인트를 쓴다.",
        "operationId": "get_reference_basis_reference_basis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/RegulatoryBasis"
                  },
                  "type": "object",
                  "title": "Response Get Reference Basis Reference Basis Get"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{result_id}": {
      "get": {
        "summary": "Get Report",
        "description": "저장된 검사를 다시 본다. 추측불가 result_id가 접근권이라 못 찾으면 404.",
        "operationId": "get_report_reports__result_id__get",
        "parameters": [
          {
            "name": "result_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Result Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredCheck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{result_id}/image": {
      "get": {
        "summary": "Get Report Image",
        "description": "저장된 원본 이미지를 백엔드가 그대로 스트리밍(버킷 private, 서명 URL 없음).",
        "operationId": "get_report_image_reports__result_id__image_get",
        "parameters": [
          {
            "name": "result_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Result Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/check": {
      "post": {
        "summary": "Check",
        "description": "광고(이미지/글 + 나라)를 받아 문구별 위반 findings를 반환한다.\n\n이미지·글 중 최소 하나는 있어야 한다. 없으면 422. ingredients, ingredient_amounts,\nproduct_name은 선택.",
        "operationId": "check_check_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_check_check_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/remediate": {
      "post": {
        "summary": "Remediate",
        "description": "위반 문구(sentence)와 유형(violation_type)을 입력받아 대체 표현을 제안한다.",
        "operationId": "remediate_remediate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemediationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemediationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/generate": {
      "post": {
        "summary": "Generate",
        "description": "검사된 광고를 안전 버전으로 생성·개선한다(FR-11/13, improve).\n\n위반 문구는 조건표로 결정적 치환, 저위험 서술은 LLM 생성, 생성물은 재검증한다.",
        "operationId": "generate_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasisCitation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "law_name": {
            "type": "string",
            "title": "Law Name"
          },
          "citation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation Id"
          },
          "effective_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Date"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "law_name"
        ],
        "title": "BasisCitation",
        "description": "규제 근거 인용 하나. `citation_registry.json` 항목을 API 응답용으로 축약한다.\n\n2026-08-13 프론트 푸터가 화장품과 무관한 식품 도메인 고시번호(\"2025-79호\")를\n하드코딩해 표시한 사고가 있었다. 그 뒤로 규제 근거 문자열은 어디서도 하드코딩\n하지 않고 전부 이 레지스트리(`citation_registry.json`)에서 읽는다."
      },
      "Body_check_check_post": {
        "properties": {
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "ad_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ad Text"
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "ingredients": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingredients",
            "description": "전성분(콤마 구분). 있으면 2호 판정에 성분 정합 대조가 붙는다."
          },
          "ingredient_amounts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingredient Amounts",
            "description": "\"성분:함량\" 콤마구분(예: \"나이아신아마이드:3%,알부틴:10%\"). 명시된 성분만 함량기준 대조까지 더해져 2호 판정이 더 정확해진다."
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name",
            "description": "상품명 또는 광고 제목. 있으면 판정 대상에 포함된다."
          }
        },
        "type": "object",
        "required": [
          "region"
        ],
        "title": "Body_check_check_post"
      },
      "CheckReport": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "unjudged": {
            "items": {
              "$ref": "#/components/schemas/UnjudgedSentence"
            },
            "type": "array",
            "title": "Unjudged"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "result_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Id"
          },
          "basis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegulatoryBasis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "findings",
          "summary"
        ],
        "title": "CheckReport",
        "description": "`POST /check` 응답. findings + unjudged + summary.\n\nresult_id: 이 검사가 저장됐으면 그 추측불가 id(다시 보기 URL). 저장 안 됐으면\n(JUDGE_KIND=stub·DB 미설정·저장 실패) None. 프론트는 있으면 다시 보기 링크를 건다.\nbasis: 검사 시점에 실제 적용된 규제 근거 스냅샷. 나중에 레지스트리가 갱신돼도\n이 리포트를 다시 볼 때는 검사 당시 값 그대로 보여야 해서 결과에 박아 보낸다."
      },
      "Finding": {
        "properties": {
          "span": {
            "type": "string",
            "title": "Span"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          },
          "violation_type": {
            "$ref": "#/components/schemas/ViolationType"
          },
          "legal_basis": {
            "type": "string",
            "title": "Legal Basis"
          },
          "flag": {
            "$ref": "#/components/schemas/JudgmentFlag"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        },
        "type": "object",
        "required": [
          "span",
          "sentence",
          "violation_type",
          "legal_basis",
          "flag",
          "explanation",
          "location"
        ],
        "title": "Finding",
        "description": "문구 하나에 대한 판정 결과. 리포트에 한 줄로 렌더된다."
      },
      "GenerateRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "improve",
              "create"
            ],
            "title": "Mode",
            "default": "improve"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "개선 대상 원본 광고 텍스트(improve 모드 필수)"
          },
          "result_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Id",
            "description": "검사 결과 참조(이미지·맥락)"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name"
          },
          "ingredients": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingredients",
            "description": "전성분(콤마 구분, improve 모드용)"
          },
          "ingredient_amounts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/IngredientAmount"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingredient Amounts",
            "description": "성분명+함량(create 모드 전용, 인정문구 함량기준 대조에 씀)"
          },
          "certifications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Certifications"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "설문/추가 제품정보 자유서술"
          },
          "image_generation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageGenRequest"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "GenerateRequest",
        "description": "`POST /generate` 요청. `mode`로 improve(개선)/create(신규 생성) 분기.\n\nimprove: content(원본 광고 텍스트) 필수. 저장된 검사엔 위반 문장만 있고\n원문 전체가 없어, 개선하려면 프론트가 원본 텍스트를 넘긴다(하니 승인).\ncreate: content 없이 product_name·ingredient_amounts·certifications만으로\n인증서 매칭 인정문구를 조립한다(효능표현 자유창작 금지, 조건표 대신\n인증서-인정문구 매칭이 소스)."
      },
      "GenerateResponse": {
        "properties": {
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          },
          "replacements": {
            "items": {
              "$ref": "#/components/schemas/Replacement"
            },
            "type": "array",
            "title": "Replacements"
          },
          "image_plan": {
            "$ref": "#/components/schemas/ImagePlan"
          },
          "pii_removed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pii Removed"
          },
          "risk_confirmations": {
            "items": {
              "$ref": "#/components/schemas/RiskConfirmation"
            },
            "type": "array",
            "title": "Risk Confirmations"
          },
          "skipped_claims": {
            "items": {
              "$ref": "#/components/schemas/SkippedClaim"
            },
            "type": "array",
            "title": "Skipped Claims"
          },
          "recheck": {
            "$ref": "#/components/schemas/RecheckSummary"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "type": "object",
        "required": [
          "sections",
          "replacements",
          "image_plan",
          "recheck",
          "disclaimer"
        ],
        "title": "GenerateResponse",
        "description": "`POST /generate` 응답. 구조화 콘텐츠 + 치환내역 + 이미지계획 + 재검증."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageGenRequest": {
        "properties": {
          "requested": {
            "type": "boolean",
            "title": "Requested",
            "default": false
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          }
        },
        "type": "object",
        "title": "ImageGenRequest",
        "description": "이미지 생성 요청 입력(선택). requested=True일 때 prompt를 필터링한다."
      },
      "ImageGenResult": {
        "properties": {
          "requested": {
            "type": "boolean",
            "title": "Requested",
            "default": false
          },
          "allowed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "ai_labeled": {
            "type": "boolean",
            "title": "Ai Labeled",
            "default": false
          }
        },
        "type": "object",
        "title": "ImageGenResult",
        "description": "이미지 생성 요청 처리 결과(FR-13). 이번 MVP는 실제 생성 안 함(가드레일만).\n\nrequested=True인데 allowed=False면 사칭 필터에 걸린 것(reason에 사유).\nallowed=True여도 ai_labeled/생성물은 없다(생성기 미도입, 폴백)."
      },
      "ImagePlan": {
        "properties": {
          "placed": {
            "items": {
              "$ref": "#/components/schemas/PlacedImage"
            },
            "type": "array",
            "title": "Placed"
          },
          "generation": {
            "$ref": "#/components/schemas/ImageGenResult"
          }
        },
        "type": "object",
        "title": "ImagePlan",
        "description": "이미지 배치 + 생성 가드레일 결과(FR-13)."
      },
      "IngredientAmount": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "amount": {
            "type": "string",
            "title": "Amount",
            "description": "함량 원문 표기, 예: \"2%\", \"2~5%\", \"2,500 IU/g\""
          }
        },
        "type": "object",
        "required": [
          "name",
          "amount"
        ],
        "title": "IngredientAmount",
        "description": "create 모드 전용: 성분명 + 함량(원문 표기 그대로, 예 \"2%\"·\"2,500 IU/g\").\n\n기존 `ingredients`(콤마 성분명 문자열)는 함량이 없어 인정문구 함량기준\n대조에 못 쓴다. improve 모드는 이 필드를 쓰지 않는다(회귀 없음)."
      },
      "JudgmentFlag": {
        "type": "string",
        "enum": [
          "위반",
          "검토필요"
        ],
        "title": "JudgmentFlag",
        "description": "판정 확정도. v1.8: 위험도(고/중/저) 등급 폐지 → 위반/검토필요 이진화.\n\n'근거 있으면 위반, 근거 없으면 검토필요'(FR-5). RagJudge 이전엔 대부분\n유형에 규칙집 대조 수단이 없어 잠정적으로 위반으로 둔다(recall 우선).\n2호(기능성오인)만 예외다. 성분 정합이 실제 근거 대조라 그 결과를 쓴다."
      },
      "Location": {
        "properties": {
          "tile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
