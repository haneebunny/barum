# backend 환경변수 예시. 실제 값은 backend/.env 에 두고 커밋하지 않는다.
# 사용: cp .env.example .env 후 값 채우기.
#
# 주석 처리된 줄은 **안 정하면 코드 기본값**이 쓰인다. 기본값을 같이 적어뒀으니
# 바꿀 때만 주석을 풀면 된다. `.env`에 심볼릭 링크를 걸지 말 것(원본이 날아간다).

# ── API 키 ────────────────────────────────────────────────────────────────
# Gemini API 키 (Google AI Studio 발급 키)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 11번가 Open API: eleventh_st_crawler.py / collect_11st_details.py
ELEVENTH_ST_API_KEY=

# Supabase (검사 이력·사례 pgvector 검색). 없으면 사례 검색은 끄고 규정만으로 판정한다.
SUPABASE_URL=
SUPABASE_KEY=

# ── 역할별 provider ───────────────────────────────────────────────────────
# JUDGE_PROVIDER=openai      # 판정. gemini도 가능(43문장 비교에서 미탐이 많아 openai 채택)
# OCR_PROVIDER=gemini        # 이미지 OCR
# GENERATE_PROVIDER=         # 콘텐츠 생성. 미설정 시 JUDGE_PROVIDER를 따른다
# PRESCREEN_PROVIDER=        # 1차 필터. 미설정 시 JUDGE_PROVIDER를 따른다
# IMAGE_PROVIDER=gemini      # 이미지 생성(나노 바나나). openai·cloudflare로 되돌릴 수 있다

# ── 역할별 모델명 ─────────────────────────────────────────────────────────
# 미설정이면 아래 provider 기본값으로 폴백한다(동작 무변경).
# 역할별로 나눠 두는 이유: 1차 필터는 이진 분류라 판정보다 싼 모델을 써도 된다.
# JUDGE_MODEL=               # 미설정 → OPENAI_MODEL
# PRESCREEN_MODEL=           # 미설정 → 판정 VLM을 그대로 재사용(호출기 하나)
# OCR_MODEL=                 # 미설정 → MODEL_NAME
# GENERATE_MODEL=            # 미설정 → OPENAI_MODEL
# IMAGE_MODEL=               # 미설정 → IMAGE_MODEL_NAME

# provider 기본 모델명(위 역할별 값이 없을 때 쓰인다)
# MODEL_NAME=gemini-3.5-flash-lite            # Gemini 텍스트·OCR
# OPENAI_MODEL=gpt-5-mini                     # OpenAI 텍스트
# IMAGE_MODEL_NAME=gemini-3.1-flash-lite-image  # 나노 바나나. 참조 사진 라벨 보존 확인된 모델
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024
# CLOUDFLARE_IMAGE_MODEL=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── 동작 스위치 ───────────────────────────────────────────────────────────
# JUDGE_KIND=rag             # rag(기본) | prompt(제로샷, 비교실험용) | stub(외부 호출 없음)
# BARUM_VERIFY_GATE=1        # 1(기본) 인용 대조 켬. 0이면 대조 없이 모델 설명 그대로
# BARUM_GROUNDING_CHECKLIST=1  # 1(기본) KCA 실증자료 체크리스트를 근거에 싣는다
# BARUM_REWRITE_GROUNDING=1  # 1(기본) 대체표현 재작성기에 규칙문서·인정문구·적발사례를 싣는다
# CHECK_REPLACEMENTS=1       # 1(기본) /check 때 대체표현을 같이 만든다
# REPLACEMENT_BATCH_SIZE=1   # 대체표현 생성을 몇 건씩 묶어 부를지. 작을수록 빠르다
# CHECK_MAX_WORKERS=4        # /check의 OCR·1차필터·판정 배치를 동시에 몇 개까지 보낼지. 1이면 순차
# REPLACEMENT_MAX_WORKERS=6  # 동시 호출 상한
# IMAGE_GENERATION_ENABLED=0 # 0(기본) 이미지 생성 끔. 1이면 과금 발생
# IMAGE_CACHE_ENABLED=1      # 같은 이미지 재검사 시 캐시 사용
# GENERATE_CACHE_ENABLED=1   # 1(기본) 같은 입력이면 상세페이지를 다시 만들지 않는다
# CHECKS_PERSIST=            # 검사 결과 Supabase 저장 여부

# ── LangSmith (관측) ──────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=barum
