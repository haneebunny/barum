# ── Python ──
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
*.egg-info/

# ── secrets ──
.env
.env.*
!.env.example

# ── 운영/학습 데이터 (git 밖, Supabase / 파일시스템에 둔다) ──
backend/data/
backend/11st_output/
backend/11st_probe_cosmetic/
backend/coupang_output/
backend/**/tiles/

# ── 엑셀 임시 락파일 ──
~$*

# ── 내부 문서(비공개) ──
*.pdf
*.docx

# ── OS / 에디터 ──
.DS_Store
*.swp
.idea/
.vscode/

# ── Claude Code 로컬 설정 · 설치된 스킬/플러그인 (툴링, repo에 안 넣음) ──
.claude/settings.local.json
.claude/skills/
.claude/plugins/
.claude/worktrees/

# ── frontend (Next.js) ──
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*.local
design/mockups/fonts/

# ── design/mockups: 목업 html은 추적하지 않는다 ──
# 정적 목업이라 깃 히스토리에 남길 실익이 없다(재포맷만으로 1000줄대 diff가 난다).
# 규칙 문서(DESIGN.md·long-canvas-placement-rules.md)와 로고·파비콘은 계속 추적한다.
design/mockups/*.html
